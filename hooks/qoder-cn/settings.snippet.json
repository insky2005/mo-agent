{
  "_comment": "推荐用 /agents 或 npm run hooks:qoder-cn 自动配置。这个文件只作手动兜底：合并进 ~/.qoder-cn/settings.json（CN 版运行时实际读取），不要整体覆盖，并把 <ABSOLUTE_PATH> 换成绝对路径。",
  "hooks": {
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node <ABSOLUTE_PATH>/approvals/hook-cli.mjs event PermissionRequest qoder-cn",
            "timeout": 600
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node <ABSOLUTE_PATH>/approvals/hook-cli.mjs event Notification qoder-cn",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
