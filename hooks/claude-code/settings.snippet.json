{
  "_comment": "推荐用设置页 /agents 或 npm run hooks:install 自动配置。这个文件只作手动兜底：合并进 ~/.claude/settings.json（不要整体覆盖），并把 <ABSOLUTE_PATH> 换成绝对路径。",
  "hooks": {
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node <ABSOLUTE_PATH>/approvals/hook-cli.mjs event PermissionRequest claude-code",
            "timeout": 600
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node <ABSOLUTE_PATH>/approvals/hook-cli.mjs event Notification claude-code",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
