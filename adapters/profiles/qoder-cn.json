{
  "id": "qoder-cn",
  "label": "Qoder CN",
  "enabled": true,
  "module": "./qoder-cn.mjs",
  "export": "QoderCnAdapter",
  "process": {
    "match": [
      "(^|/)Qoder CN($|\\s)",
      "(^|/)qoderclicn?($|\\s)"
    ]
  },
  "session": {
    "kind": "jsonl-transcript",
    "root": "~/.qoder-cn/projects",
    "pattern": "*/*.jsonl"
  },
  "capabilities": {
    "observe": [
      "process",
      "transcript"
    ],
    "runEnd": "explicit",
    "attention": "hook",
    "approval": "allow",
    "control": []
  },
  "hooks": {
    "kind": "qoder-cn",
    "settingsFile": "~/.qoder-cn/settings.json",
    "events": {
      "PermissionRequest": "approval.pending",
      "Notification": "notice",
      "Stop": "notice"
    },
    "labels": {
      "PermissionRequest": "授权请求：手机可批准 / 拒绝",
      "Notification": "通知：Agent 需要关注时推送提醒",
      "Stop": "任务完成：IDE 每轮结束时通知（桌面端由 transcript 负责）"
    }
  },
  "approval": {
    "capability": "allow",
    "mechanism": "PermissionRequest hook（decision.behavior，与 Claude Code 同格式）",
    "note": "桌面端会同时弹自己的授权框，和 hook 是竞速：桌面框先被处理/超时，手机上的允许就不会再生效。常用工具建议在手机选「总是允许」，后续请求由 hook 立即放行；或改用 CLI/TUI。"
  }
}
