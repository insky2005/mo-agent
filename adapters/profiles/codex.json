{
  "id": "codex",
  "label": "Codex CLI",
  "enabled": false,
  "process": { "match": ["(^|/)codex($|\\s)"] },
  "session": { "kind": "jsonl-transcript", "root": "~/.codex/sessions", "pattern": "**/*.jsonl" },
